# Supply a real, existing big-endian s390x Granite GGUF from the event lab.
# The model filename below is a placeholder, not an included or downloadable asset.
GRANITE_MODEL_PATH=/models/YOUR-BIG-ENDIAN-GRANITE.gguf
# Must match the internal caller's X-Risk-Secret. Generate at least 32 characters.
RISK_SHARED_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# C must supply/review these files. The bundled .example files are starting points.
GRANITE_PII_PROMPT_PATH=/prompts/pii_second_pass.txt
GRANITE_NOTE_PROMPT_PATH=/prompts/adjuster_note.txt
GRANITE_THREADS=2
GRANITE_CONTEXT=1024
GRANITE_MAX_TOKENS=256
GRANITE_QUEUE_SIZE=4
GRANITE_JOB_RETENTION_SECONDS=900
# Optional, only if needed by the supplied GGUF; otherwise its embedded chat template is used.
# GRANITE_CHAT_FORMAT=...
